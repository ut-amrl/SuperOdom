      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        map:
          base_link:
            camera_link:
              {}
            gps_link:
              {}
            ground_link:
              {}
            imu_link:
              imu_link_rect:
                {}
            lidar_link:
              lidar_link_rect:
                {}
              livox_frame/base_link:
                {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
